#!name=YS7 AdBlock
#!desc=拦截萤石(EZVIZ)/YS7 App 内的广告与推广域名
#!author=WorkBuddy
#!category=我的
#!system=ios
#!version=1.1

[Rule]
# ===== 萤石自有广告素材与广告配置域名 =====
DOMAIN,ad-material.ys7.com,REJECT-DROP
DOMAIN,ecapi-flood.ys7.com,REJECT-DROP

# ===== 广告联盟 / 第三方推广域名（淘宝广告、360 推广） =====
DOMAIN,wcp.taobao.com,REJECT-DROP
DOMAIN,rtb.julang.taobao.com,REJECT-DROP
DOMAIN,qh-material.taobao.com,REJECT-DROP
DOMAIN,www.so.com,REJECT-DROP

# ===== 广告监测 / 数据统计（追踪上报）域名 =====
DOMAIN,mssdk.volces.com,REJECT-DROP
DOMAIN,tnc3-alisc1.zijieapi.com,REJECT-DROP
DOMAIN,abt-online.netease.im,REJECT-DROP
DOMAIN,log.ys7.com,REJECT-DROP
DOMAIN,stats.ys7.com,REJECT-DROP


[URL Rewrite]
# 萤石自有广告配置 / 物料接口
^https?://api\.ys7\.com/api/ads/.* _ reject
# 广告数据服务（广告位、开屏提醒、应用列表等）
^https?://api\.ys7\.com/v3/ad/.* _ reject
# 广告 SDK 配置查询
^https?://api\.ys7\.com/v3/adService/sdkConfig/query _ reject
^https:\/\/api\.ys7\.com\/api\/ads\/query\/adConfig\?.* _ reject
# 按空间返回的广告位内容（首页/设备页广告注入点）
^https?://api\.ys7\.com/v3/clouds/cloudbiz/getAdvertisingBySpaceId.* _ reject
# 广告统计上报（客户端→服务端，纯上报，直接断开）
^https?://api\.ys7\.com/v3/ad/data/report/statistics.* _ reject
# 社区
^https?:\/\/api\.ys7\.com\/v3\/videoclips\/community\/.* - reject


[Body Rewrite]
# 商城主页
http-response-jq ^https?://m\.ys7\.com/default/rn-index\?.* ".data.tabs.[].tagName="1"|.data.page.[].data=[{},{}]|.data.tabs.[].data=[{},{}]"
# 
http-response-jq ^https?://m\.ys7\.com/default/index-waterfall-tab-list\?.* ".data.tabs.[].tagName="2"|.data.page.[].data=[{},{}]|.data.tabs.[].data=[{},{}]"
# 我的页面 > 只显示管理中心
http-response-jq ^https?\:\/\/api\.ys7\.com\/v3\/valueadded\/operation\/config\/master\/station.* ".stationInfo.groupList = [.stationInfo.groupList[0]]"
# 我的页面 > 用户会员
http-response-jq ^https?:\/\/api\.ys7\.com\/v3\/config\/service\/entrance\/bannerInfo.* ".bannerInfo.list = []"
# 总配置
# http-response-jq ^https?:\/\/api.ys7.com\/v3\/configurations\/gray\/info.+ ".grayConfigInfos.83.switchStatus=3"

[MITM]
hostname=%APPEND% api.ys7.com,m.ys7.com

# ============================================================================
# Host：对独立广告域名做 DNS 层兜底拦截（与 [Rule] REJECT 互补）
# 注意：切勿将 api.ys7.com 映射为空地址，否则会连同核心业务一起失效。
# ============================================================================
